+void tst_QWebEngineExtension::tabsWindowsAndScripting()
+{
+    // The tabs, windows, permissions and scripting namespaces answer from the pages the embedder
+    // owns: the page below is the one tab of the one window, its own content script is told so,
+    // and a script the extension injects into it by tab id reaches the same document. The page is
+    // served over HTTP because an extension's host permissions cannot match qrc.
+    HttpServer server;
+    server.setResourceDirs({ resourcesPath() });
+    QVERIFY(server.start());
+
+    QWebEngineExtensionInfo extension = loadExtensionSync(resourcesPath() + "tabs_ext"_L1);
+    QVERIFY(extension.isLoaded());
+    m_manager->setExtensionEnabled(extension, true);
+
+    QSignalSpy loadSpy(m_page, SIGNAL(loadFinished(bool)));
+    m_page->load(server.url("/index.html"_L1));
+    QTRY_COMPARE(loadSpy.size(), 1);
+
+    QTRY_VERIFY(evaluateJavaScriptSync(m_page, "!!document.getElementById('testNode')").toBool());
+    const QVariantMap result =
+            evaluateJavaScriptSync(m_page,
