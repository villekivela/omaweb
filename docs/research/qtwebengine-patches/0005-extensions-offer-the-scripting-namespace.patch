--- /dev/null
+++ b/tests/auto/widgets/extensions/resources/tabs_ext/service_worker.js
@@ -0,0 +1,21 @@
+chrome.runtime.onMessage.addListener((message, sender, sendResponse) => {
+    if (message !== "probe")
+        return false;
+    (async () => {
+        const tabs = await chrome.tabs.query({})
+        const windows = await chrome.windows.getAll({ populate: true })
+        const hasTabs = await chrome.permissions.contains({ permissions: ["tabs"] })
+        await chrome.scripting.executeScript({
+            target: { tabId: sender.tab.id },
+            func: () => { document.title = "injected" },
+        })
+        sendResponse({
+            senderTabUrl: sender.tab.url,
+            queriedUrls: tabs.map(tab => tab.url),
+            windowCount: windows.length,
+            windowTabCount: windows[0].tabs.length,
+            hasTabsPermission: hasTabs,
+        })
+    })()
+    return true;
+})
