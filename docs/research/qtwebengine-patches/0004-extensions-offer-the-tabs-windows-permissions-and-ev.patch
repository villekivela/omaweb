+// Copyright (C) 2026 The Qt Company Ltd.
+// SPDX-License-Identifier: LicenseRef-Qt-Commercial OR LGPL-3.0-only OR GPL-2.0-only OR GPL-3.0-only
+
+#ifndef QTWEBENGINE_BROWSER_EXTENSIONS_TAB_REGISTRY_QT_H_
+#define QTWEBENGINE_BROWSER_EXTENSIONS_TAB_REGISTRY_QT_H_
+
+#include <vector>
+
+#include "base/values.h"
+#include "qtwebengine/common/extensions/api/tabs.h"
+
+namespace content {
+class BrowserContext;
+class WebContents;
+}  // namespace content
+
+namespace extensions {
+
+// QtWebEngine has no tab strip of its own. The application embedding it does, so the tabs and
+// windows APIs ask it, through this delegate, which of a browser context's WebContents are tabs
+// and which one the user is looking at. Tab ids are assigned here and stay with the WebContents.
+class TabsDelegateQt {
+ public:
+  virtual ~TabsDelegateQt() = default;
+
+  // Every WebContents of the context that an extension should see as a tab, in tab order.
+  virtual std::vector<content::WebContents*> GetTabs(
+      content::BrowserContext* context) = 0;
+  // The tab the user is looking at, or null when none is.
+  virtual content::WebContents* GetActiveTab(content::BrowserContext* context) = 0;
+};
+
+class TabRegistryQt {
+ public:
+  static TabRegistryQt* Get();
+
+  void SetDelegate(TabsDelegateQt* delegate);
+
+  // The id of |web_contents|, assigned on first sight. Never -1 for a live WebContents.
+  int GetTabId(content::WebContents* web_contents);
+  int GetWindowId(content::WebContents* web_contents);
+  // The tab with |tab_id| in |context|, or null.
+  content::WebContents* GetWebContents(content::BrowserContext* context, int tab_id);
+
+  std::vector<content::WebContents*> GetTabs(content::BrowserContext* context);
+  content::WebContents* GetActiveTab(content::BrowserContext* context);
+
+  // The tabs.Tab description of |web_contents| as the API returns it.
+  api::tabs::Tab CreateTab(content::WebContents* web_contents);
+  base::Value::Dict CreateTabValue(content::WebContents* web_contents);
+
+  // The one window every tab of a context lives in for now.
+  static constexpr int kWindowId = 1;
+
+ private:
+  TabRegistryQt() = default;
+
+  TabsDelegateQt* delegate_ = nullptr;
+};
