+ExtensionFunction::ResponseAction TabsGetFunction::Run() {
+  std::optional<tabs::Get::Params> params = tabs::Get::Params::Create(args());
+  EXTENSION_FUNCTION_VALIDATE(params);
+  content::WebContents* contents =
+      TabRegistryQt::Get()->GetWebContents(browser_context(), params->tab_id);
+  if (!contents)
+    return RespondNow(Error(TabNotFoundError(params->tab_id)));
+  return RespondNow(WithArguments(TabRegistryQt::Get()->CreateTabValue(contents)));
+}
+
+ExtensionFunction::ResponseAction TabsGetCurrentFunction::Run() {
+  // Chrome answers undefined from a context that is not a tab, such as a popup or a worker.
+  content::WebContents* contents = GetSenderWebContents();
+  if (!contents)
+    return RespondNow(NoArguments());
+  contents = guest_view::GuestViewBase::GetTopLevelWebContents(contents);
+  for (content::WebContents* tab : TabRegistryQt::Get()->GetTabs(browser_context())) {
+    if (tab == contents)
+      return RespondNow(WithArguments(TabRegistryQt::Get()->CreateTabValue(contents)));
+  }
+  return RespondNow(NoArguments());
+}
+
+ExtensionFunction::ResponseAction TabsQueryFunction::Run() {
+  std::optional<tabs::Query::Params> params = tabs::Query::Params::Create(args());
+  EXTENSION_FUNCTION_VALIDATE(params);
+  const tabs::Query::Params::QueryInfo& query = params->query_info;
+
+  // Every tab of the context lives in the one window, so currentWindow, lastFocusedWindow and
+  // windowId all select it or nothing.
+  if (query.window_id && *query.window_id != TabRegistryQt::kWindowId &&
+      *query.window_id != -2 /* WINDOW_ID_CURRENT */) {
+    return RespondNow(WithArguments(base::Value::List()));
+  }
+
+  std::vector<URLPattern> url_patterns;
+  if (query.url) {
+    std::vector<std::string> patterns;
+    if (query.url->as_string)
+      patterns.push_back(*query.url->as_string);
+    else if (query.url->as_strings)
+      patterns = *query.url->as_strings;
+    for (const std::string& pattern : patterns) {
+      URLPattern url_pattern(URLPattern::SCHEME_ALL);
+      if (url_pattern.Parse(pattern) != URLPattern::ParseResult::kSuccess)
+        return RespondNow(Error(ErrorUtils::FormatErrorMessage("Invalid url pattern: \"*\"", pattern)));
+      url_patterns.push_back(url_pattern);
+    }
+  }
+
+  TabRegistryQt* registry = TabRegistryQt::Get();
+  content::WebContents* active_tab = registry->GetActiveTab(browser_context());
+  base::Value::List result;
+  int index = -1;
+  for (content::WebContents* tab : registry->GetTabs(browser_context())) {
+    ++index;
+    const bool active = tab == active_tab;
+    if (query.active && *query.active != active)
+      continue;
+    if (query.highlighted && *query.highlighted != active)
+      continue;
+    if (query.pinned && *query.pinned)
+      continue;
+    if (query.audible && *query.audible != tab->IsCurrentlyAudible())
+      continue;
+    if (query.discarded && *query.discarded)
+      continue;
+    if (query.frozen && *query.frozen)
+      continue;
+    if (query.index && *query.index != index)
+      continue;
+    if (query.status != tabs::TabStatus::kNone) {
+      const bool loading = tab->IsLoading();
+      if ((query.status == tabs::TabStatus::kLoading) != loading)
+        continue;
+    }
+    if (query.title &&
+        !base::MatchPattern(base::UTF16ToUTF8(tab->GetTitle()), *query.title)) {
+      continue;
+    }
+    if (!url_patterns.empty()) {
+      const GURL& url = tab->GetLastCommittedURL();
+      bool matched = false;
+      for (const URLPattern& pattern : url_patterns)
+        matched = matched || pattern.MatchesURL(url);
+      if (!matched)
+        continue;
+    }
+    result.Append(registry->CreateTabValue(tab));
+  }
+  return RespondNow(WithArguments(std::move(result)));
+}
