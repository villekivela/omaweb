+#include "content/public/browser/web_contents_user_data.h"
+
+namespace extensions {
+
+namespace {
+
+// The id lives on the WebContents, so it survives the delegate changing its mind about what is
+// a tab and dies with the page rather than needing a removal call.
+class TabIdData : public content::WebContentsUserData<TabIdData> {
+ public:
+  int id() const { return id_; }
+
+ private:
+  friend class content::WebContentsUserData<TabIdData>;
+  explicit TabIdData(content::WebContents* web_contents)
+      : content::WebContentsUserData<TabIdData>(*web_contents), id_(NextId()) {}
+
+  static int NextId() {
+    static int next = 0;
+    return ++next;
+  }
+
+  const int id_;
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+
+WEB_CONTENTS_USER_DATA_KEY_IMPL(TabIdData);
+
+}  // namespace
+
+// static
+TabRegistryQt* TabRegistryQt::Get() {
+  static TabRegistryQt registry;
+  return &registry;
+}
+
+void TabRegistryQt::SetDelegate(TabsDelegateQt* delegate) {
+  delegate_ = delegate;
+}
+
+int TabRegistryQt::GetTabId(content::WebContents* web_contents) {
+  if (!web_contents)
+    return -1;
+  TabIdData::CreateForWebContents(web_contents);
+  return TabIdData::FromWebContents(web_contents)->id();
+}
+
+int TabRegistryQt::GetWindowId(content::WebContents* web_contents) {
+  return web_contents ? kWindowId : -1;
+}
+
+content::WebContents* TabRegistryQt::GetWebContents(content::BrowserContext* context,
+                                                    int tab_id) {
+  for (content::WebContents* tab : GetTabs(context)) {
+    if (GetTabId(tab) == tab_id)
+      return tab;
+  }
+  return nullptr;
+}
+
+std::vector<content::WebContents*> TabRegistryQt::GetTabs(content::BrowserContext* context) {
+  if (!delegate_)
+    return {};
+  return delegate_->GetTabs(context);
+}
+
+content::WebContents* TabRegistryQt::GetActiveTab(content::BrowserContext* context) {
+  if (!delegate_)
+    return nullptr;
+  return delegate_->GetActiveTab(context);
+}
+
+api::tabs::Tab TabRegistryQt::CreateTab(content::WebContents* web_contents) {
+  api::tabs::Tab tab;
+  content::BrowserContext* context = web_contents->GetBrowserContext();
+  std::vector<content::WebContents*> tabs = GetTabs(context);
+  int index = -1;
+  for (size_t i = 0; i < tabs.size(); ++i) {
+    if (tabs[i] == web_contents)
+      index = static_cast<int>(i);
+  }
+  const bool active = GetActiveTab(context) == web_contents;
+
+  tab.id = GetTabId(web_contents);
+  tab.index = index;
+  tab.group_id = -1;
+  tab.window_id = kWindowId;
+  tab.selected = active;
+  tab.highlighted = active;
+  tab.active = active;
+  tab.pinned = false;
+  tab.discarded = false;
+  tab.auto_discardable = true;
+  tab.frozen = false;
+  tab.last_accessed = base::Time::Now().InMillisecondsFSinceUnixEpoch();
+  tab.incognito = context->IsOffTheRecord();
+  tab.audible = web_contents->IsCurrentlyAudible();
+  tab.url = web_contents->GetLastCommittedURL().spec();
+  if (content::NavigationEntry* pending = web_contents->GetController().GetPendingEntry())
+    tab.pending_url = pending->GetURL().spec();
+  tab.title = base::UTF16ToUTF8(web_contents->GetTitle());
+  tab.status = web_contents->IsLoading() ? api::tabs::TabStatus::kLoading
+                                         : api::tabs::TabStatus::kComplete;
+  return tab;
+}
+
+base::Value::Dict TabRegistryQt::CreateTabValue(content::WebContents* web_contents) {
+  return CreateTab(web_contents).ToValue();
+}
+
+}  // namespace extensions
