+namespace extensions {
+
+namespace windows = api::windows;
+
+namespace {
+
+constexpr int kWindowIdCurrent = -2;
+
+base::Value::Dict CreateWindowValue(content::BrowserContext* context,
+                                    const std::optional<windows::QueryOptions>& options) {
+  windows::Window window;
+  window.id = TabRegistryQt::kWindowId;
+  window.focused = true;
+  window.incognito = context->IsOffTheRecord();
+  window.type = windows::WindowType::kNormal;
+  window.state = windows::WindowState::kNormal;
+  window.always_on_top = false;
+  if (options && options->populate && *options->populate) {
+    std::vector<api::tabs::Tab> tabs;
+    for (content::WebContents* tab : TabRegistryQt::Get()->GetTabs(context))
+      tabs.push_back(TabRegistryQt::Get()->CreateTab(tab));
+    window.tabs = std::move(tabs);
+  }
+  return window.ToValue();
+}
+
+std::string NoWindowError(int window_id) {
+  return ErrorUtils::FormatErrorMessage("No window with id: *.",
+                                        base::NumberToString(window_id));
+}
