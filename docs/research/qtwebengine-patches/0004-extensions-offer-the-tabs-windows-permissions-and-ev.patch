+#ifndef QTWEBENGINE_BROWSER_EXTENSIONS_API_PERMISSIONS_PERMISSIONS_API_HELPERS_H_
+#define QTWEBENGINE_BROWSER_EXTENSIONS_API_PERMISSIONS_PERMISSIONS_API_HELPERS_H_
+
+#include <memory>
+#include <string>
+
+#include "extensions/buildflags/buildflags.h"
+#include "extensions/common/permissions/api_permission_set.h"
