+ExtensionFunction::ResponseAction WindowsGetAllFunction::Run() {
+  std::optional<windows::GetAll::Params> params = windows::GetAll::Params::Create(args());
+  EXTENSION_FUNCTION_VALIDATE(params);
+  base::Value::List result;
