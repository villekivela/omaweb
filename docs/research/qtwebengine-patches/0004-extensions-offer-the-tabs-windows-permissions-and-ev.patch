+std::vector<content::WebContents *> ExtensionsBrowserClientQt::GetTabs(content::BrowserContext *context)
+{
+    std::vector<content::WebContents *> tabs;
+    QtWebEngineCore::ProfileAdapter *adapter = static_cast<QtWebEngineCore::ProfileQt *>(context)->profileAdapter();
+    if (!adapter)
+        return tabs;
+    for (QtWebEngineCore::WebContentsAdapterClient *client : adapter->webContentsAdapterClients()) {
+        QtWebEngineCore::WebContentsAdapter *contents = client->webContentsAdapter();
+        if (contents && contents->isInitialized() && contents->webContents()
+            && !isExtensionPage(contents->webContents()))
+            tabs.push_back(contents->webContents());
+    }
+    return tabs;
+}
+
+content::WebContents *ExtensionsBrowserClientQt::GetActiveTab(content::BrowserContext *context)
+{
+    QtWebEngineCore::ProfileAdapter *adapter = static_cast<QtWebEngineCore::ProfileQt *>(context)->profileAdapter();
+    if (!adapter)
+        return nullptr;
+    content::WebContents *active = nullptr;
+    for (QtWebEngineCore::WebContentsAdapterClient *client : adapter->webContentsAdapterClients()) {
+        QtWebEngineCore::WebContentsAdapter *contents = client->webContentsAdapter();
+        if (!contents || !contents->isInitialized() || !contents->webContents()
+            || isExtensionPage(contents->webContents()))
+            continue;
+        if (!active || contents->isVisible())
+            active = contents->webContents();
+    }
+    return active;
+}
+
+void ExtensionsBrowserClientQt::GetTabAndWindowIdForWebContents(content::WebContents *web_contents,
+                                                                int *tab_id, int *window_id)
+{
+    *tab_id = TabRegistryQt::Get()->GetTabId(web_contents);
+    *window_id = TabRegistryQt::Get()->GetWindowId(web_contents);
+}
+
+bool ExtensionsBrowserClientQt::IsValidTabId(content::BrowserContext *browser_context, int tab_id,
+                                             bool include_incognito, content::WebContents **web_contents) const
+{
+    content::WebContents *contents = TabRegistryQt::Get()->GetWebContents(browser_context, tab_id);
+    if (!contents)
+        return false;
+    if (web_contents)
+        *web_contents = contents;
+    return true;
 }
 
 void ExtensionsBrowserClientQt::Init()
