From f42e9e6ae9cd4db2afc4bc7bb1a880ea73519916 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Ville=20Kivela=CC=88?= <vkivela@hotmail.com>
Date: Fri, 18 Sep 2026 07:38:21 +0300
Subject: [PATCH 3/3] extensions: keep ExtensionPrefs valid when the
 PrefService is rebuilt

Changing a profile's storage name, off-the-record flag or storage path
after construction rebuilds its PrefService. ProfileQt then replaced the
ExtensionPrefs instance, but ExtensionRegistrar, EventRouter and the other
keyed services created with the profile keep the pointer they cached, and
the next setExtensionEnabled() dereferenced the destroyed PrefService in
ExtensionPrefs::GetExtensionPref(). Re-point the existing instance instead,
through a small hook on ExtensionPrefs guarded by IS_QTWEBENGINE.
---
 .gitignore                                    |  2 ++
 .../extensions/browser/extension_prefs.cc     | 14 +++++++++++
 .../extensions/browser/extension_prefs.h      |  9 ++++++++
 src/core/profile_qt.cpp                       | 20 +++++-----------
 .../extensions/tst_qwebengineextension.cpp    | 23 +++++++++++++++++++
 5 files changed, 54 insertions(+), 14 deletions(-)

diff --git a/.gitignore b/.gitignore
index 41ae81158e..e61acf454c 100644
--- a/.gitignore
+++ b/.gitignore
@@ -1,2 +1,4 @@
 build/
 *.log
+build.sh
+__pycache__/
diff --git a/src/3rdparty/chromium/extensions/browser/extension_prefs.cc b/src/3rdparty/chromium/extensions/browser/extension_prefs.cc
index 134efed8ef..1ebd391878 100644
--- a/src/3rdparty/chromium/extensions/browser/extension_prefs.cc
+++ b/src/3rdparty/chromium/extensions/browser/extension_prefs.cc
@@ -438,6 +438,20 @@ ExtensionPrefs::~ExtensionPrefs() {
   DCHECK(observer_list_.begin() == observer_list_.end());
 }
 
+#if BUILDFLAG(IS_QTWEBENGINE)
+void ExtensionPrefs::ResetPrefService(PrefService* prefs,
+                                      const base::FilePath& root_dir) {
+  prefs_ = prefs;
+  install_directory_ = root_dir;
+  MakePathsRelative();
+  InitPrefStore();
+  BackfillAndMigrateInstallTimePrefs();
+  MigrateDeprecatedDisableReasons();
+  MaybeMigrateDisableReasonsBitflagToList();
+  MaybeClearExtensionStatePref();
+}
+#endif
+
 // static
 ExtensionPrefs* ExtensionPrefs::Get(content::BrowserContext* context) {
   return ExtensionPrefsFactory::GetInstance()->GetForBrowserContext(context);
diff --git a/src/3rdparty/chromium/extensions/browser/extension_prefs.h b/src/3rdparty/chromium/extensions/browser/extension_prefs.h
index 8673af6183..97c396ef93 100644
--- a/src/3rdparty/chromium/extensions/browser/extension_prefs.h
+++ b/src/3rdparty/chromium/extensions/browser/extension_prefs.h
@@ -233,6 +233,15 @@ class ExtensionPrefs : public KeyedService {
   // Convenience function to get the ExtensionPrefs for a BrowserContext.
   static ExtensionPrefs* Get(content::BrowserContext* context);
 
+#if BUILDFLAG(IS_QTWEBENGINE)
+  // Points this instance at a replacement PrefService and install directory.
+  // QtWebEngine rebuilds a profile's PrefService when the embedder changes
+  // the storage path after the extension system exists; re-pointing keeps
+  // every ExtensionPrefs pointer cached by other keyed services valid, where
+  // replacing the instance would leave them dangling.
+  void ResetPrefService(PrefService* prefs, const base::FilePath& root_dir);
+#endif
+
   // Add or remove an observer from the ExtensionPrefs.
   void AddObserver(ExtensionPrefsObserver* observer);
   void RemoveObserver(ExtensionPrefsObserver* observer);
diff --git a/src/core/profile_qt.cpp b/src/core/profile_qt.cpp
index c0fdad2a8f..7e715a9131 100644
--- a/src/core/profile_qt.cpp
+++ b/src/core/profile_qt.cpp
@@ -34,10 +34,7 @@
 #if BUILDFLAG(ENABLE_EXTENSIONS)
 #include "base/command_line.h"
 #include "components/guest_view/browser/guest_view_manager.h"
-#include "extensions/browser/extension_pref_value_map_factory.h"
 #include "extensions/browser/extension_prefs.h"
-#include "extensions/browser/extension_prefs_factory.h"
-#include "extensions/browser/extensions_browser_client.h"
 
 #include "extensions/extension_manager.h"
 #include "extensions/extension_system_qt.h"
@@ -239,17 +236,12 @@ void ProfileQt::setupPrefService()
 
 #if BUILDFLAG(ENABLE_EXTENSIONS)
     if (recreation) {
-        // Recreate ExtensionPrefs to update its pointer to the new PrefService
-        extensions::ExtensionsBrowserClient *client = extensions::ExtensionsBrowserClient::Get();
-        std::vector<extensions::EarlyExtensionPrefsObserver *> prefsObservers;
-        client->GetEarlyExtensionPrefsObservers(this, &prefsObservers);
-        auto extensionPrefs = extensions::ExtensionPrefs::Create(
-            this, client->GetPrefServiceForContext(this),
-            this->GetPath().AppendASCII(extensions::kInstallDirectoryName),
-            ExtensionPrefValueMapFactory::GetForBrowserContext(this),
-            client->AreExtensionsDisabled(*base::CommandLine::ForCurrentProcess(), this),
-            prefsObservers);
-        extensions::ExtensionPrefsFactory::GetInstance()->SetInstanceForTesting(this, std::move(extensionPrefs));
+        // Point the existing ExtensionPrefs at the new PrefService. Replacing the instance would
+        // leave the ExtensionRegistrar, EventRouter and every other keyed service that cached it
+        // at construction holding a dangling pointer, and the next setExtensionEnabled() would
+        // read the destroyed PrefService.
+        extensions::ExtensionPrefs::Get(this)->ResetPrefService(
+                GetPrefs(), GetPath().AppendASCII(extensions::kInstallDirectoryName));
     }
 #endif
 }
diff --git a/tests/auto/widgets/extensions/tst_qwebengineextension.cpp b/tests/auto/widgets/extensions/tst_qwebengineextension.cpp
index ecbb5b791d..b37ef1ec81 100644
--- a/tests/auto/widgets/extensions/tst_qwebengineextension.cpp
+++ b/tests/auto/widgets/extensions/tst_qwebengineextension.cpp
@@ -42,6 +42,7 @@ private Q_SLOTS:
     void loadInstalledExtensions();
     void serviceWorkerMessaging();
     void serviceWorkerLocalization();
+    void enableAfterStoragePathChange();
 
 private:
     int installedFiles();
@@ -422,5 +423,27 @@ void tst_QWebEngineExtension::serviceWorkerLocalization()
                  "hello from the worker"_L1);
 }
 
+void tst_QWebEngineExtension::enableAfterStoragePathChange()
+{
+    // Changing the storage path after construction rebuilds the profile's PrefService. The
+    // extension system must keep reading the live one rather than the one it was created with.
+    QTemporaryDir tempDir(QDir::tempPath() + "/tst_QWebEngineExtension-XXXXXX"_L1);
+    QWebEngineProfile profile("StoragePathChange");
+    QWebEngineExtensionManager *manager = profile.extensionManager();
+    QCOMPARE(manager->extensions().size(), 2);
+    profile.setPersistentStoragePath(tempDir.path());
+
+    QSignalSpy spy(manager, SIGNAL(loadFinished(QWebEngineExtensionInfo)));
+    manager->loadExtension(resourcesPath() + "unpacked_ext"_L1);
+    QTRY_COMPARE(spy.size(), 1);
+    QWebEngineExtensionInfo extension = spy.takeFirst().value(0).value<QWebEngineExtensionInfo>();
+    QVERIFY(extension.isLoaded());
+    manager->setExtensionEnabled(extension, true);
+    QVERIFY(extension.isEnabled());
+    manager->setExtensionEnabled(extension, false);
+    QVERIFY(!extension.isEnabled());
+    QVERIFY(QDir(manager->installPath()).removeRecursively());
+}
+
 QTEST_MAIN(tst_QWebEngineExtension)
 #include "tst_qwebengineextension.moc"
