+void tst_QWebEngineExtension::nativeMessaging()
+{
+#ifdef Q_OS_WIN
+    QSKIP("The host is a script with a shebang, which Windows does not launch.");
+#else
+    // An extension reaches a program outside the browser through a host manifest installed for
+    // this application, which names the extensions the host will answer.
+    QWebEngineExtensionInfo extension =
+            loadExtensionSync(resourcesPath() + "native_messaging_ext"_L1);
+    QVERIFY(extension.isLoaded());
+
+    const QString hostsDir =
+            QStandardPaths::writableLocation(QStandardPaths::AppDataLocation)
+            + QStringLiteral("/NativeMessagingHosts");
+    QVERIFY(QDir().mkpath(hostsDir));
+    auto writeManifest = [&](const QString &hostName, const QString &allowedId) {
+        auto manifest = std::make_unique<QFile>(hostsDir + u'/' + hostName + ".json"_L1);
+        if (!manifest->open(QIODevice::WriteOnly | QIODevice::Truncate))
+            return std::unique_ptr<QFile>();
+        manifest->write(QStringLiteral("{\n"
+                                       "  \"name\": \"%1\",\n"
+                                       "  \"description\": \"Echo host\",\n"
+                                       "  \"path\": \"%2\",\n"
+                                       "  \"type\": \"stdio\",\n"
+                                       "  \"allowed_origins\": [\"chrome-extension://%3/\"]\n"
+                                       "}\n")
+                                .arg(hostName, resourcesPath() + "echo_host.py"_L1, allowedId)
+                                .toUtf8());
+        manifest->close();
+        return manifest;
+    };
+    // One host names this extension, the other names a different one and must be refused.
+    std::unique_ptr<QFile> allowed = writeManifest("com.example.echo"_L1, extension.id());
+    QVERIFY(allowed);
+    std::unique_ptr<QFile> forbidden =
+            writeManifest("com.example.forbidden"_L1,
+                          "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"_L1);
+    QVERIFY(forbidden);
+    auto removeManifests = qScopeGuard([&] {
+        allowed->remove();
+        forbidden->remove();
+    });
+
+    m_manager->setExtensionEnabled(extension, true);
+
+    HttpServer server;
+    server.setResourceDirs({ resourcesPath() });
+    QVERIFY(server.start());
+    QSignalSpy loadSpy(m_page, SIGNAL(loadFinished(bool)));
+    m_page->load(server.url("/index.html"_L1));
+    QTRY_COMPARE(loadSpy.size(), 1);
+
+    QTRY_VERIFY(evaluateJavaScriptSync(m_page, "!!document.getElementById('testNode')").toBool());
+    const QVariantMap result =
+            evaluateJavaScriptSync(m_page,
+                                   "JSON.parse(document.getElementById('testNode').textContent)")
+                    .toMap();
+    QCOMPARE(result["allowed"_L1].toMap()["echoed"_L1].toMap()["value"_L1].toString(),
+             "sent through the host"_L1);
+    QCOMPARE(result["forbidden"_L1].toMap()["error"_L1].toString(),
+             "Access to the specified native messaging host is forbidden."_L1);
+#endif
+}
+
 QTEST_MAIN(tst_QWebEngineExtension)
 #include "tst_qwebengineextension.moc"
