diff --git a/tests/auto/widgets/extensions/resources/echo_host.py b/tests/auto/widgets/extensions/resources/echo_host.py
new file mode 100755
index 0000000000..8f63d0a79d
--- /dev/null
+++ b/tests/auto/widgets/extensions/resources/echo_host.py
@@ -0,0 +1,32 @@
+#!/usr/bin/env python3
+"""A native messaging host that answers each message with what it received."""
+import json
+import struct
+import sys
+
+
+def read_message():
+    header = sys.stdin.buffer.read(4)
+    if len(header) < 4:
+        return None
+    length = struct.unpack("=I", header)[0]
+    return json.loads(sys.stdin.buffer.read(length).decode("utf-8"))
+
+
+def write_message(message):
+    payload = json.dumps(message).encode("utf-8")
+    sys.stdout.buffer.write(struct.pack("=I", len(payload)))
+    sys.stdout.buffer.write(payload)
+    sys.stdout.buffer.flush()
+
+
+def main():
+    while True:
+        message = read_message()
+        if message is None:
+            return
+        write_message({"echo": message, "pid": __import__("os").getpid()})
+
+
+if __name__ == "__main__":
+    main()
