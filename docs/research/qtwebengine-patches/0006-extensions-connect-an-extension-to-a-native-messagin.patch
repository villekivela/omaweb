@@ -0,0 +1,23 @@
+function connect(hostName, sendResponse) {
+    const port = chrome.runtime.connectNative(hostName)
+    port.onMessage.addListener(response => {
+        sendResponse({ echoed: response.echo })
+        port.disconnect()
+    })
+    port.onDisconnect.addListener(() => {
+        sendResponse({ error: chrome.runtime.lastError ? chrome.runtime.lastError.message : "closed" })
+    })
+    port.postMessage({ value: "sent through the host" })
+}
+
+chrome.runtime.onMessage.addListener((message, sender, sendResponse) => {
+    if (message === "probe") {
+        connect("com.example.echo", sendResponse)
+        return true;
+    }
+    if (message === "probeForbidden") {
+        connect("com.example.forbidden", sendResponse)
+        return true;
+    }
+    return false;
+})
