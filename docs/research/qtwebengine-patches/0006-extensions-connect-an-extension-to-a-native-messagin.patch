+const results = {}
+
+function report(name, response) {
+    results[name] = response
+    if (!("allowed" in results) || !("forbidden" in results))
+        return
+    let testNode = document.createElement("div")
+    testNode.id = "testNode"
+    testNode.textContent = JSON.stringify(results)
+    document.body.appendChild(testNode)
+}
+
+chrome.runtime.sendMessage("probe", response => report("allowed", response))
+chrome.runtime.sendMessage("probeForbidden", response => report("forbidden", response))
