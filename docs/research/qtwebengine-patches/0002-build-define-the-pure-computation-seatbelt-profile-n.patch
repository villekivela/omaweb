From cbbb8f8d30658cfc6693409ea257f9ab203ccca8 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Ville=20Kivela=CC=88?= <vkivela@hotmail.com>
Date: Fri, 18 Sep 2026 17:47:03 +0300
Subject: [PATCH 2/5] build: define the pure-computation seatbelt profile name
 ourselves

Local build fix for the Xcode 27 / macOS 26 SDK, which dropped
kSBXProfilePureComputation from <sandbox.h>. Not part of the extension
series.
---
 src/3rdparty/chromium/sandbox/mac/seatbelt.cc | 7 +++----
 1 file changed, 3 insertions(+), 4 deletions(-)

diff --git a/src/3rdparty/chromium/sandbox/mac/seatbelt.cc b/src/3rdparty/chromium/sandbox/mac/seatbelt.cc
index 789439fc28..78544f39c0 100644
--- a/src/3rdparty/chromium/sandbox/mac/seatbelt.cc
+++ b/src/3rdparty/chromium/sandbox/mac/seatbelt.cc
@@ -109,10 +109,9 @@ Seatbelt::Parameters::~Parameters() {
 }
 
 // Initialize the static member variables.
-#pragma clang diagnostic push
-#pragma clang diagnostic ignored "-Wdeprecated-declarations"
-const char* Seatbelt::kProfilePureComputation = kSBXProfilePureComputation;
-#pragma clang diagnostic pop
+// The macOS 26 SDK removed kSBXProfilePureComputation from <sandbox.h>. Its value has always
+// been the profile name below, and nothing in this tree reads the member.
+const char* Seatbelt::kProfilePureComputation = "pure-computation";
 
 // static
 bool Seatbelt::Init(const char* profile, uint64_t flags, std::string* error) {
