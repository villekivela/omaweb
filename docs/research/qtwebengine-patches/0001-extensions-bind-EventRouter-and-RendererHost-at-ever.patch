+    "greeting": { "message": "hello from the worker" }
+}
diff --git a/tests/auto/widgets/extensions/resources/localized_worker_ext/content_script.js b/tests/auto/widgets/extensions/resources/localized_worker_ext/content_script.js
new file mode 100644
index 0000000000..e7b046cea7
--- /dev/null
+++ b/tests/auto/widgets/extensions/resources/localized_worker_ext/content_script.js
@@ -0,0 +1,6 @@
+chrome.runtime.sendMessage("ping", (response) => {
+    let testNode = document.createElement("div")
+    testNode.id = "testNode"
+    testNode.textContent = response
+    document.body.appendChild(testNode)
+})
