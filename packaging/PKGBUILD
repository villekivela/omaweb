# Maintainer: Ville Kivelä <5814559+villekivela@users.noreply.github.com>
#
# Omaweb has no published release tarball yet, so this builds from the
# repository and takes its version from the nearest release tag, which is where
# CMake takes it from as well (ADR 0028). The two cannot disagree.
#
# Qt comes from the system, apart from the engine. Omaweb builds and ships its
# own QtWebEngine, because a Known extension needs patches the distribution's
# engine does not carry (ADR 0049, which supersedes ADR 0013 on this point).
# That engine is its own package installed under /usr/lib/omaweb, so Omaweb
# builds and runs against it rather than against qt6-webengine.

pkgname=omaweb-git
_pkgname=omaweb
pkgver=0.2.1.r1.g77f0e26
pkgrel=1
pkgdesc="A keyboard-driven web browser"
arch=('x86_64' 'aarch64')
url="https://github.com/villekivela/omaweb"
license=('MPL-2.0')
depends=(
    'qt6-base'
    'qt6-declarative'
    # The patched engine, not the distribution's. Extensions do not work
    # against qt6-webengine, and the two install side by side.
    'omaweb-qtwebengine'
    # Native Wayland is the primary display platform. X11 stays a fallback Qt
    # supplies through qt6-base.
    'qt6-wayland'
    'hicolor-icon-theme'
    'git'
    'libsecret'
    'libsodium'
    # `xdg-settings`, which is how Settings offers to become the default
    # browser. Without it the offer is not made.
    'xdg-utils'
)
makedepends=('cmake' 'ninja' 'clang' 'rust' 'python')
optdepends=(
    # Qt is pointed at an input-method plugin by the desktop environment, and
    # Omarchy points it at fcitx. Without the plugin installed Qt loads no input
    # context and never binds the Wayland text-input protocol, so an input
    # method silently does nothing. See docs/development.md.
    'fcitx5-qt: input methods under Wayland'
    # Omaweb asks Chromium for VA-API video decoding, and a driver has to be
    # there to answer. Which one depends on the GPU, so this is a choice the
    # host makes rather than a dependency the package can name. Without any of
    # them Omaweb decodes video in software and starts normally. Each driver
    # pulls in the `libva` runtime it plugs into, so naming that as well would
    # add nothing. See docs/development.md.
    'intel-media-driver: hardware video decode on Intel GPUs from Broadwell on'
    'libva-intel-driver: hardware video decode on Intel GPUs before Broadwell'
    'mesa: hardware video decode on AMD GPUs, through the Mesa VA-API driver'
    'libva-nvidia-driver: hardware video decode on NVIDIA GPUs, over NVDEC'
    'libva-utils: `vainfo`, which reports which driver answers on this host'
)
provides=("$_pkgname=$pkgver")
conflicts=("$_pkgname")
# Prints the Hyprland window rule an Omarchy reader has to add by hand. Omarchy
# owns its own rule directory, so the package cannot install the rule itself.
install="$pkgname.install"
# The repository this file sits in, rather than a fresh clone of the remote.
# `makepkg` run from a checkout should package the tree the reader has in front
# of them, including commits they have not pushed, which is what the README's
# instructions read as. `scripts/check_package.sh` and the release workflow
# rewrite this line to name their own checkout, for the same reason.
#
# `makepkg` still keeps its clone of it under `packaging/`. A run that is
# interrupted leaves that clone incomplete, and every later run then fails at
# "Creating working copy" because the directory is there and is not a
# repository. Removing `packaging/omaweb` is the repair, and the README says so.
source=("$_pkgname::git+file://${startdir%/*}")
sha256sums=('SKIP')

pkgver() {
    cd "$_pkgname"
    # `--long` so a build sitting exactly on a tag still carries the count and
    # the hash, and one version never stands for two different commits.
    git describe --long --tags --match 'v[0-9]*' | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
}

prepare() {
    cd "$_pkgname"
    # The content-blocking library is built from a pinned lockfile. Fetching in
    # `prepare` keeps the build itself off the network, which is what a clean
    # chroot expects.
    cargo fetch --locked --manifest-path third_party/content-blocker/Cargo.toml
}

build() {
    cd "$_pkgname"
    # CMake verifies the bootstrapped library against a recorded checksum but
    # never invokes Cargo itself, so the bootstrap runs first.
    scripts/bootstrap_content_blocker.sh

    # The repository's own release preset, so the package is the build the
    # project tests rather than a second configuration that drifts from it. It
    # embeds QML, themes and the icon font instead of reading them from a source
    # tree that will not be installed.
    # Where the patched engine is. `CMAKE_PREFIX_PATH` does not reach it:
    # `find_package(Qt6 COMPONENTS ...)` looks for each component beside the
    # `Qt6Config.cmake` it already found, which is the system one, so the
    # component search never leaves /usr/lib/cmake. Qt offers this variable for
    # exactly this case, a module installed under a prefix of its own.
    cmake --preset release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DQT_ADDITIONAL_PACKAGES_PREFIX_PATH=/usr/lib/omaweb \
        -DBUILD_TESTING=OFF \
        -DOMAWEB_BUILD_UI_LAB=OFF \
        -DCMAKE_CXX_COMPILER_LAUNCHER=
    cmake --build --preset release

    # The inventory is generated here rather than by CMake, because it reads the
    # Rust dependency graph through Cargo and CMake never invokes Cargo. It goes
    # into the package so that a reader who has the browser has the list of what
    # is in it, without having to find the release it came from.
    scripts/generate_sbom.py --output build/release/sbom.json
}

package() {
    cd "$_pkgname"
    DESTDIR="$pkgdir" cmake --install build/release
    install -Dm644 build/release/sbom.json "$pkgdir/usr/share/omaweb/sbom.json"
}
