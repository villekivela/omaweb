[
  {
    "name": "has-text",
    "rule": "127.0.0.1##.card:has-text(Sponsored)",
    "action": {
      "selector": [
        {
          "type": "css-selector",
          "arg": ".card"
        },
        {
          "type": "has-text",
          "arg": "Sponsored"
        }
      ]
    },
    "page": "<div class=\"card\" id=\"match\">Sponsored post</div><div class=\"card\" id=\"miss\">News</div>",
    "matches": ["match"]
  },
