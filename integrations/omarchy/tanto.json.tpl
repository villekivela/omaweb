{
  "schemaVersion": 1,
  "window": "{{ darker_background }}",
  "sidebar": "{{ dark_background }}",
  "overlay": "{{ dark_background }}",
  "surface": "{{ lighter_background }}",
  "surfaceHover": "{{ muted }}",
  "text": "{{ foreground }}",
  "mutedText": "{{ dark_foreground }}",
  "accent": "{{ accent }}",
  "border": "{{ muted }}",
  "privateAccent": "{{ magenta }}",
  "privateWindow": "{{ dark_background }}",
  "privateSidebar": "{{ magenta }}",
  "privateSurface": "{{ magenta }}40",
  "privateSurfaceHover": "{{ magenta }}55",
  "tint": {
    "saturation": 0.34,
    "lightness": 0.66
  },
  "font": {
    "families": ["{{ font_family }}", "JetBrains Mono", "monospace"],
    "size": 12,
    "smallSize": 10,
    "headingSize": 15,
    "labelSize": 9,
    "labelSpacing": 1.8,
    "iconSize": 17
  },
  "opacity": {
    "sidebar": 0.90,
    "overlay": 0.96,
    "window": 0.0
  }
}
