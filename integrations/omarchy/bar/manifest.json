{
  "schemaVersion": 1,
  "id": "omaweb.bar",
  "name": "Omaweb",
  "version": "1.0.0",
  "author": "Omaweb",
  "license": "MIT",
  "description": "Omaweb's Space on show, the page's back, forward and reload, and its Location in the bar, and a tab switcher over every Space. Omaweb places it when its tabs are set to show in the Omarchy bar.",
  "kinds": ["bar-widget", "overlay"],
  "entryPoints": {
    "barWidget": "OmawebBar.qml",
    "overlay": "OmawebTabs.qml"
  },
  "barWidget": {
    "displayName": "Omaweb",
    "description": "The Space on show, which opens the tab switcher, and the Location of the page on show.",
    "category": "Productivity",
    "aliases": ["browser", "tabs"],
    "allowMultiple": false,
    "defaultSection": "center",
    "defaults": {
      "spaceNames": "full",
      "locationWidth": 360
    },
    "schema": [
      {
        "key": "spaceNames",
        "type": "enum",
        "label": "Space names",
        "options": ["full", "letter"],
        "defaultValue": "full"
      },
      {
        "key": "locationWidth",
        "type": "integer",
        "label": "Location width (px)",
        "min": 160,
        "max": 800,
        "step": 20,
        "defaultValue": 360
      }
    ]
  }
}
